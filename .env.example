# Solo en el servidor. Nunca usar credenciales postgres/service_role en la PWA.
DATABASE_URL=postgresql://vexor_backend:REEMPLAZAR@HOST:5432/postgres?sslmode=verify-full&sslrootcert=supabase/certs/prod-ca-2021.crt
# Cuenta de migración para CLI/pruebas remotas; distinta de DATABASE_URL.
MIGRATION_DATABASE_URL=

# Backend local. En Render: HOST=0.0.0.0; PORT lo proporciona Render.
HOST=127.0.0.1
PORT=3000
DATABASE_POOL_MAX=5
NODE_ENV=development
APP_ORIGINS=http://localhost:5173
SUPABASE_URL=https://xlkuqntkxzwayyxovoxy.supabase.co
SUPABASE_PUBLISHABLE_KEY=REEMPLAZAR
# Solo servidor; necesaria para enviar invitaciones, nunca para el frontend.
SUPABASE_SECRET_KEY=
# Debe existir en la PWA y estar permitida en Supabase Auth / URL Configuration.
INVITATION_REDIRECT_URL=http://localhost:5173/auth/callback
