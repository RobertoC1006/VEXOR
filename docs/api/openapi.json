            "type": "string"
          }
        },
        "required": [
          "nombre"
        ]
      },
      "RolePatchDto": {
        "type": "object",
        "properties": {
          "nombre": {
            "type": "string"
          },
          "activo": {
            "type": "boolean"
          }
        }
      },
