            "type": "object",
            "nullable": true
          },
          "numero_puesto": {
            "type": "object",
            "nullable": true
          },
          "referencia": {
            "type": "object",
            "nullable": true
          },
          "nombre": {
            "type": "string"
          },
          "habilitado_venta": {
            "type": "boolean",
            "default": false
          },
          "activo": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "MemberPatchDto": {
        "type": "object",
        "properties": {
          "activo": {
            "type": "boolean"
          },
          "es_propietario": {
            "type": "boolean"
          }
        }
      },
      "RoleCreateDto": {
        "type": "object",
        "properties": {
