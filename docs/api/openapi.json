            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "permisos"
        ]
      },
      "MemberRoleDto": {
        "type": "object",
        "properties": {
          "rol_id": {
            "type": "string",
            "format": "uuid"
          },
          "local_id": {
            "type": "object",
            "format": "uuid",
            "nullable": true
          }
        },
        "required": [
          "rol_id"
        ]
      },
      "MemberLocalsDto": {
        "type": "object",
        "properties": {
          "locales_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "locales_ids"
        ]
      },
      "IndividualPermissionDto": {
        "type": "object",
        "properties": {
          "permiso_codigo": {
            "type": "string"
          },
          "efecto": {
            "type": "string",
            "enum": [
              "permitir",
              "denegar"
            ]
          },
          "local_id": {
            "type": "object",
            "format": "uuid",
            "nullable": true
          },
          "inicia_en": {
            "type": "string",
            "format": "date-time"
          },
          "vence_en": {
            "type": "object",
            "format": "date-time",
            "nullable": true
          },
          "motivo": {
            "type": "object",
            "nullable": true
          }
        },
        "required": [
          "permiso_codigo",
          "efecto"
        ]
      },
      "IndividualPermissionPatchDto": {
        "type": "object",
        "properties": {
          "efecto": {
            "type": "string",
            "enum": [
              "permitir",
              "denegar"
            ]
          },
          "inicia_en": {
            "type": "string",
            "format": "date-time"
          },
          "vence_en": {
            "type": "object",
            "format": "date-time",
            "nullable": true
          },
          "motivo": {
            "type": "object",
            "nullable": true
          }
        }
      },
