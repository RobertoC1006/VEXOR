            "type": "object",
            "nullable": true
          },
          "referencia": {
            "type": "object",
            "nullable": true
          },
          "nombre": {
            "type": "string"
          },
          "habilitado_venta": {
            "type": "boolean",
            "default": false
          },
          "activo": {
            "type": "boolean",
            "default": true
          }
        },
        "required": [
          "nombre"
        ]
      },
      "LocalPatchDto": {
        "type": "object",
        "properties": {
          "mercado": {
