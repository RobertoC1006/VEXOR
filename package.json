{
  "name": "vexor",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:api && npm run build:web",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.runtime dist/backend/main.js",
    "test:api": "npm run build:api && node --import tsx backend/tests/api.ts",
    "db:provision-runtime": "node --env-file-if-exists=.env --import tsx backend/scripts/provision-runtime.ts",
    "db:bootstrap-admin": "node --env-file-if-exists=.env --import tsx backend/scripts/bootstrap-platform-admin.ts",
    "db:test": "node --import tsx backend/tests/db.ts",
    "db:test:remote": "node --import tsx backend/scripts/test-remote.ts",
    "db:test:postgres": "node --import tsx backend/tests/postgres.ts",
    "db:migrate": "supabase --workdir backend db push",
    "db:reset": "supabase --workdir backend db reset",
    "typecheck": "npm run typecheck:api && npm run typecheck:web",
    "build:api": "tsc -p backend/tsconfig.build.json",
    "build:web": "node --import tsx frontend/scripts/build-web.ts",
    "dev:web": "vite --config frontend/vite.config.ts",
    "dev:api": "npm run build:api && npm start",
    "typecheck:api": "tsc -p backend/tsconfig.json",
    "typecheck:web": "tsc -p frontend/tsconfig.json",
    "test:web": "vitest run --config frontend/vitest.config.ts",
    "demo:browser": "npm run build:api && node --import tsx backend/scripts/demo-browser.ts",
    "demo:setup": "node --env-file-if-exists=.env --env-file-if-exists=.env.runtime --import tsx backend/scripts/setup-demo.ts",
    "test:hosting": "npm run build:api && node --env-file-if-exists=.env --env-file-if-exists=.env.runtime --import tsx backend/scripts/test-hosting.ts",
    "test:client-build": "node --env-file-if-exists=.env --env-file-if-exists=.env.runtime --import tsx frontend/scripts/test-client-build.ts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@supabase/supabase-js": "^2.118.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.3.0",
    "kysely": "^0.28.8",
    "lucide-react": "^1.60.0",
    "pg": "^8.16.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/express": "^5.0.6",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "embedded-postgres": "17.10.0-beta.17",
    "jose": "^6.2.13",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "supabase": "^2.54.11",
    "supertest": "^7.3.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
